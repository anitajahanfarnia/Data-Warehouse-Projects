            <component
              refId="Package\Data Flow Task\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH MyCTE AS
(
    SELECT *,
           CHECKSUM(*) AS Hash1
    FROM
    (
        SELECT
            o.OrderID,
            CustomerID,
            EmployeeID,
            OrderDate,
            RequiredDate,
            ShippedDate,
            ShipVia,
            ShipCity,
            ShipRegion,
            ShipPostalCode,
            ShipCountry,
            ProductID,
            UnitPrice,
            Quantity,
            Discount,
            COUNT(*) OVER (PARTITION BY o.OrderID) AS NumberOfOrders,
            Freight / COUNT(*) OVER (PARTITION BY o.OrderID) AS NewFreight
        FROM Orders AS o
        INNER JOIN [Order Details] AS od
            ON o.OrderID = od.OrderID
    ) AS x
)

SELECT 
       t1.OrderID AS OrderID1,
       t1.CustomerID AS CustomerID1,
       t1.EmployeeID AS EmployeeID1,
       t1.OrderDate AS OrderDate1,
       t1.RequiredDate AS RequiredDate1,
       t1.ShippedDate AS ShippedDate1,
       t1.ShipVia AS ShipVia1,
       t1.ShipCity AS ShipCity1,
       t1.ShipRegion AS ShipRegion1,
       t1.ShipPostalCode AS ShipPostalCode1,
       t1.ShipCountry AS ShipCountry1,
       t1.ProductID AS ProductID1,
       t1.UnitPrice AS UnitPrice1,
       t1.Quantity AS Quantity1,
       t1.Discount AS Discount1,
       t1.NumberOfOrders AS NumberOfOrders1,
       t1.NewFreight AS NewFreight1,
    t1.*,

       CASE
           WHEN t1.OrderID IS NULL THEN 'deleted'
           WHEN t2.OrderID IS NULL THEN 'inserted'
           WHEN t1.Hash1 &lt;&gt; t2.Hash1 THEN 'updated'
       END AS Status

FROM MyCTE AS t1

FULL OUTER JOIN Table2 AS t2
    ON t1.OrderID = t2.OrderID

WHERE
    t1.Hash1 &lt;&gt; t2.Hash1
    OR t1.OrderID IS NULL
    OR t2.OrderID IS NULL;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
